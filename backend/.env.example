# Copy this file to backend/.env (or .env at the repository root).
# Never commit the populated file.

# OpenRouter: LLM planning, image generation, and OpenRouter video routes.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# fal: fal video/audio-reference routes and word-level transcription.
# https://fal.ai/dashboard/keys
FAL_API_KEY=

# Suno-compatible music generation API.
SUNO_SOURCE=sunoapi.org
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.org

# Local app configuration.
STORAGE_DIR=./storage
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8010

# Keys from VIDEO_MODELS / IMAGE_MODELS / LLM_MODELS in app/config.py.
DEFAULT_VIDEO_MODEL=kling-v3.0-pro
DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image
DEFAULT_LLM_MODEL=google/gemini-3-flash-preview
