# ============================================================
# Music Video Studio — backend env vars
# ============================================================
# Copy this file to `.env` (in this directory OR the repo root —
# Settings reads either) and fill in real values. The .env file
# is gitignored.

# ─── REQUIRED ────────────────────────────────────────────────

# OpenRouter — primary provider for video / image / LLM calls.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── OPTIONAL ────────────────────────────────────────────────

# fal.ai — only needed for lipsync (LatentSync model). All other
# video / image / audio work runs through OpenRouter.
# https://fal.ai/dashboard/keys
FAL_API_KEY=

# Suno — alternative music generator (we default to Lyria via
# OpenRouter, but you can switch in the UI per-project).
# source = "official" (if you have access) or "sunoapi.org" (unofficial wrapper)
SUNO_SOURCE=sunoapi.org
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.org

# ─── APP CONFIG (defaults are fine for local dev) ────────────

# Where generated media goes. Relative paths are resolved against
# the backend/ directory. On macOS use a forward-slash path.
STORAGE_DIR=./storage

# Frontend URL — used for CORS allow-list.
FRONTEND_URL=http://localhost:3000

# Public URL where /storage/* assets are reachable by the browser.
# Set to your deployed backend URL when behind a reverse proxy.
PUBLIC_BASE_URL=http://localhost:8010

# ─── DEFAULT MODELS (overridable per-project / per-scene) ────
# These values are the keys from VIDEO_MODELS / IMAGE_MODELS /
# LLM_MODELS in backend/app/config.py. Pick keys from there if
# you want to change defaults — invalid keys silently fall back
# to whatever's first in the dict.

DEFAULT_VIDEO_MODEL=kling-v3.0-pro
DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image
DEFAULT_LLM_MODEL=google/gemini-3-flash-preview
